# Copy to .env and fill in real values there. .env is git-ignored and must never be committed.
# Placeholders only in this file (constitution, Secrets).

# Database used by the backend. docker-compose.yml already sets this for local development.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pak_tax_filer

# AI provider key, needed from feature 003 (extraction) onwards; the provider is decided then.
ANTHROPIC_API_KEY=

# Session cookie over HTTPS only (default true). docker-compose.yml sets false for local HTTP.
COOKIE_SECURE=true
