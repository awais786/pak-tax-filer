{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-python.sh",
            "timeout": 60,
            "statusMessage": "Running pylint..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-frontend.sh",
            "timeout": 60,
            "statusMessage": "Running frontend lint..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/git-safety.sh",
            "timeout": 10,
            "statusMessage": "Checking git safety..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pr-cost-comment.sh",
            "timeout": 30,
            "statusMessage": "Posting session usage to PR..."
          }
        ]
      }
    ]
  }
}
