; Import rules for the guardrails (feature 008, research R4; constitution Principle I).
; The tax engine, the rates and the wealth reconciliation are plain, deterministic code: they
; may not reach the AI, directly or through any module that calls it. Run: uv run lint-imports

[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:no-ai-in-calculations]
name = Tax and wealth calculations never import the AI
type = forbidden
source_modules =
    app.tax.engine
    app.tax.calculator
    app.tax.rates
    app.wealth.reconcile
; import-linter can only forbid an outside package whole, so "google" (Gemini's google.genai,
; and anything else of Google's, which the calculations don't need either).
forbidden_modules =
    google
    app.documents.extraction
    app.rag

; Feature 011 (research R14): the admin area never calls a model. Direct imports only: it reads
; confirmed documents through app.documents.service (Principle III), which imports the extraction
; client, and the Ask limit from app.rag.service. tests/guardrails/test_admin_no_ai.py proves it
; at run time.
[importlinter:contract:no-ai-in-admin]
name = The admin area never imports a model client directly
type = forbidden
source_modules =
    app.admin
forbidden_modules =
    google
    app.documents.extraction
    app.rag.answer
    app.rag.embed
allow_indirect_imports = True
